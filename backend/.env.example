# Copy this file to backend/.env and fill in your email settings.

# Where users open verification / reset links (use your local site URL, not file://)
FRONTEND_URL=http://localhost:9999

# Ably realtime API key (https://ably.com) — REQUIRED for multiplayer Battle rooms.
# Without it, /api/battle/token returns 500 and battle rooms cannot connect.
ABLY_API_KEY=your_ably_api_key_here

# Option A — Brevo (https://brevo.com) — recommended (HTTP API, works on hosts that block SMTP)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER=your_verified_sender@example.com

# Option B — Resend (https://resend.com)
# RESEND_API_KEY=re_your_api_key_here
# SMTP_FROM=onboarding@resend.dev
# Note: onboarding@resend.dev only delivers to your Resend account email until you verify a domain.

# Option B — Gmail / SMTP (use an app password, not your normal Gmail password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=Footy-Trivia <your@gmail.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
