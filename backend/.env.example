# Copy to backend/.env and fill in every required value.
# Never commit backend/.env to git.

# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/footytrivia
SECRET_KEY=generate-a-long-random-secret

# Docker Compose only (used by docker-compose.yml for the Postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_PASSWORD
POSTGRES_DB=footytrivia

# Where users open verification / reset links
FRONTEND_URL=http://localhost:9999

# ── Optional integrations ───────────────────────────────────────────────────
# TheSportsDB player photo search (https://www.thesportsdb.com/api.php)
SPORTSDB_API_KEY=your_sportsdb_api_key

# Ably realtime (https://ably.com) — required for multiplayer Battle rooms
ABLY_API_KEY=your_ably_api_key

# Supabase storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_KEY=your_service_role_key

# Email — Option A: Brevo (recommended)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER=your_verified_sender@example.com

# Email — Option B: Resend
# RESEND_API_KEY=re_your_api_key
# SMTP_FROM=onboarding@resend.dev

# Email — Option C: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Footy-Trivia <your@gmail.com>
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# Production cookie settings (set COOKIE_SECURE=true on HTTPS hosts)
# COOKIE_SECURE=true

# Set ENVIRONMENT=production on deployed hosts (disables /docs, enables stricter defaults)
# ENVIRONMENT=production

# Trust X-Forwarded-For from your reverse proxy (Render, Vercel edge, etc.)
# TRUST_PROXY_HEADERS=true

# Access tokens expire after 30 minutes by default; refresh rotates the session.
# ACCESS_TOKEN_EXPIRE_MINUTES=30
